    "url": "git+https://github.com/Caraveo/arcmark-editor.git"
  },
  "bugs": {
    "url": "https://github.com/Caraveo/arcmark-editor/issues"
  },
  "homepage": "https://github.com/Caraveo/arcmark-editor#readme",
  "dependencies": {
    "@caraveo/arcmark-viewer": "file:../../packages/arcmark-viewer"
  },
  "engines": {
    "node": ">=18"
